<%- include('partials/header') %>

<nav class="breadcrumb">
  <a href="/">Home</a> /
  <a href="/?category=<%= encodeURIComponent(product.category) %>"><%= product.category %></a> /
  <span><%= product.brand %></span>
</nav>

<section class="pdp">
  <div class="pdp-img">
    <img src="<%= product.image %>" alt="<%= product.brand %> <%= product.name %>" />
  </div>
  <div class="pdp-info">
    <h1 class="pdp-brand"><%= product.brand %></h1>
    <p class="pdp-name"><%= product.name %></p>
    <div class="pdp-rating">★ <%= product.rating %> | <%= product.ratingCount.toLocaleString('en-IN') %> Ratings</div>
    <div class="pdp-price">
      <span class="now">₹<%= product.price.toLocaleString('en-IN') %></span>
      <span class="mrp">₹<%= product.mrp.toLocaleString('en-IN') %></span>
      <span class="off"><%= discountPercent(product) %>% OFF</span>
    </div>
    <p class="tax-note">inclusive of all taxes</p>

    <div class="pdp-sizes">
      <span class="label">Select Size</span>
      <div class="sizes">
        <% ['S','M','L','XL'].forEach(function(s){ %>
          <button type="button" class="size-pill"><%= s %></button>
        <% }); %>
      </div>
    </div>

    <div class="pdp-actions">
      <form action="/cart/add/<%= product.id %>" method="post">
        <button type="submit" class="btn-primary big">🛍 Add to Bag</button>
      </form>
      <form action="/wishlist/toggle/<%= product.id %>" method="post">
        <button type="submit" class="btn-outline big">♥ Wishlist</button>
      </form>
    </div>

    <div class="pdp-details">
      <h3>Product Details</h3>
      <p>This <%= product.name.toLowerCase() %> from <%= product.brand %> combines comfort and style.
         A versatile pick for your <%= product.category.toLowerCase() %> wardrobe.</p>
    </div>
  </div>
</section>

<% if (related.length) { %>
  <section>
    <h2 class="section-title">Similar Products</h2>
    <div class="grid">
      <% related.forEach(function(product){ %>
        <%- include('partials/card', { product: product }) %>
      <% }); %>
    </div>
  </section>
<% } %>

<%- include('partials/footer') %>
